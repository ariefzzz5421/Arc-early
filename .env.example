# Optional. Free project id from https://cloud.reown.com (formerly WalletConnect Cloud).
# Without it the site still works — RainbowKit just shows the connectors that
# don't need WalletConnect (browser-injected wallets + Coinbase Wallet).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Circle Bridge Kit runs entirely through the connected browser wallet.
# Do not add a private key, seed phrase, Circle API key, or entity secret here.

# Optional. Arc RPC endpoints used by the live network view and the wallet
# tracker. Both default to Arc's public testnet endpoints, which are shared and
# rate-limited — point them at a dedicated provider (Alchemy, QuickNode, your own
# node) if the wallet tracker's block stream keeps dropping.
#
# The websocket carries the newHeads subscription the tracker matches wallets
# against; the HTTP endpoint serves balances, nonces and the polling fallback.
# Values must start with http(s):// and ws(s):// respectively or they are ignored.
NEXT_PUBLIC_ARC_RPC_HTTP=
NEXT_PUBLIC_ARC_RPC_WS=
